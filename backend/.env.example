# Postgres connection string (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meu_guarda_roupa

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=localhost:9000
# Host embedded in presigned upload/download URLs handed to the mobile
# app/browser — must be reachable from the client device, not just the
# backend (e.g. the dev machine's LAN IP when running via docker compose).
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# JWT signing (required in staging/prod — the app has a dev-only default so
# local runs don't crash without this set, but ALWAYS override it outside
# local dev)
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional. Powers the AI "clean product photo" generated for each
# wardrobe item (ai_image_service.py) — costs real money per item saved
# once set. Leave unset to keep that feature off; nothing else breaks.
OPENAI_API_KEY=
