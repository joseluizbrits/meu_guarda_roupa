# Postgres connection string (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meu_guarda_roupa

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# JWT signing (required in staging/prod — the app has a dev-only default so
# local runs don't crash without this set, but ALWAYS override it outside
# local dev)
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
