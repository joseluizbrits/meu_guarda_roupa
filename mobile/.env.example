# Backend API base URL (FastAPI service, base path /api/v1).
# Expo exposes any EXPO_PUBLIC_* variable to client code automatically via
# process.env — no extra bundler config needed.
#
# The backend is NOT reachable via `localhost` from a physical phone on
# WiFi — it needs the dev machine's LAN IP instead. This IP changes with
# DHCP, so copy this file to `.env` and set it to your own machine's
# current LAN IP (check with `ip addr` / `ifconfig` on Linux/macOS,
# `ipconfig` on Windows).
EXPO_PUBLIC_API_URL=http://192.168.0.36:8000
