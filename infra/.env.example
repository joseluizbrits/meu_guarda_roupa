# Local dev-only credentials for `docker compose -f infra/docker-compose.yml up`.
# Copy this file to `infra/.env` and adjust if needed — never commit real secrets.

# --- Postgres ---
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=meu_guarda_roupa

# --- MinIO ---
MINIO_ROOT_USER=dev_minio_user
MINIO_ROOT_PASSWORD=dev_minio_password

# --- OpenAI (optional) ---
# Powers the AI clean-product-photo feature (backend/app/services/
# ai_image_service.py) — costs real money per wardrobe item saved once
# set. Leave unset to keep that feature off.
OPENAI_API_KEY=
